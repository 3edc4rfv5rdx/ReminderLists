<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminder engine (TZ 4.10). No Google services and no cloud (TZ 9); the one
         network use is the LAN update check declared below, and the app works
         without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Launching the full-screen alert from the alarm receiver while another app is in
         front needs the overlay grant — it lifts the background-activity-start block.
         Asked once at first launch (TZ 4.5 / 4.10). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The in-app updater: it fetches a manifest from the home server and hands
         the downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:networkSecurityConfig="@xml/updater_network_security_config"
        android:name=".ReminderListsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReminderLists.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ReminderLists.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen alert host (TZ 4.5). Shown over lockscreen when a reminder fires. -->
        <activity
            android:name=".reminders.FullScreenAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.ReminderLists" />

        <!-- Alarm fired (TZ 4.10). -->
        <receiver
            android:name=".reminders.AlarmReceiver"
            android:exported="false" />

        <!-- Plain notification action buttons: +10 min / Stop (TZ 4.5). -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <!-- Re-arm alarms after boot / update / time change (TZ 4.10). -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Foreground sound playback for firing reminders (TZ 4.10). -->
        <service
            android:name=".reminders.SoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Camera capture URIs for the shared photo module (TZ 8). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Hands the downloaded APK to the installer. Its own class rather than
             androidx FileProvider, so an app that already declares one keeps it. -->
        <provider
            android:name="dev.updater.UpdaterFileProvider"
            android:authorities="${applicationId}.updater.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/updater_file_paths" />
        </provider>
    </application>
</manifest>
